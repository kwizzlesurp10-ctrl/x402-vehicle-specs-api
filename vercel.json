{
  "version": 2,
  "buildCommand": "npm run build",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/cron/ingest", "schedule": "0 6 * * 0" },
    { "path": "/api/cron/jobs", "schedule": "*/2 * * * *" }
  ]
}
