{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator.output.schema.json",
  "type": "object",
  "required": ["request_id", "plan", "final_answer", "source_meta"],
  "properties": {
    "request_id": { "type": "string" },
    "plan": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "scout",
          "fetcher",
          "normalizer",
          "analyst",
          "verifier",
          "reporter"
        ]
      }
    },
    "final_answer": { "type": "object" },
    "source_meta": { "$ref": "common.source-meta.schema.json" }
  },
  "additionalProperties": false
}
