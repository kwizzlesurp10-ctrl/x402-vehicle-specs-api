{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analyst.input.schema.json",
  "type": "object",
  "required": ["year", "vehicle_class"],
  "properties": {
    "year": { "type": "integer", "minimum": 1984 },
    "vehicle_class": { "type": "string" },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["avg_mpg", "engine_mix", "fuel_type_mix"]
      }
    }
  },
  "additionalProperties": false
}
