# Server (local dev)
PORT=8787
NODE_ENV=development

# Postgres (Supabase)
# Pooled URL — use on Vercel/serverless (port 6543 / PgBouncer, ?pgbouncer=true)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct URL — migrations + EPA bulk ingest (port 5432)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Vercel / cron
CRON_SECRET=
API_BASE_PATH=/api
# VERCEL_MAX_DURATION_MS=300000

# x402 / Base USDC
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000
X402_NETWORK=base-sepolia
# base-sepolia -> eip155:84532; base mainnet -> eip155:8453
FACILITATOR_URL=https://x402.org/facilitator

# Per-route USD prices (exact scheme)
PRICE_SEARCH=0.001
PRICE_VEHICLE=0.002
PRICE_EMISSIONS=0.002
PRICE_COMPARE=0.005
PRICE_STATS=0.01

# EPA bulk data URLs (override only if EPA changes paths)
EPA_VEHICLES_ZIP_URL=https://fueleconomy.gov/feg/epadata/vehicles.csv.zip
EPA_EMISSIONS_ZIP_URL=https://fueleconomy.gov/feg/epadata/emissions.csv.zip

# Swarm jobs
PRICE_JOB_FLEET_ANALYSIS=0.75
PRICE_JOB_COMPARISON_REPORT=0.50
PRICE_JOB_TREND_INSIGHTS=0.35
PRICE_JOB_CUSTOM_EXPORT=0.40
PRICE_JOB_STARTER_KIT=0.25
JOB_DEPTH_MULTIPLIER_DEEP=2
JOB_MAX_CONCURRENCY=2
JOB_TIMEOUT_MS=120000
JOB_MAX_TOKENS=8000
DEFAULT_FUEL_PRICE_PER_GALLON=3.5
DEFAULT_ANNUAL_MILES=12000

# LLM (default: xAI Grok via OpenAI-compatible API)
LLM_PROVIDER=xai
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-3-mini
LLM_API_KEY=

# Example paying client (never commit real keys)
EVM_PRIVATE_KEY=
